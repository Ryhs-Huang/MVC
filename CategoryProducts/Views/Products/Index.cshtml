@section Styles {
    <link href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <style>

    </style>
}

<table class="table table-striped table-hover">
    <thead class="table-primary">
        <tr>
            <td>ProductId</td>
            <td>ProductName</td>
            <td>SupplierId</td>
            <td>CategoryId</td>
            <td>QuantutyPerUnit</td>
            <td>UnitPrice</td>
            <td>UnitsInstock</td>
            <td>UnitsOnOrder</td>
            <td>ReorderLevel</td>
            <td>Discontinued</td>
        </tr>
    </thead>
</table>

@section Scripts {
    <script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js"></script>
    <script src="//cdn.datatables.net/fixedheader/4.0.3/js/dataTables.fixedHeader.min.js"></script>

    <script>
        $(document).ready(function(){
            $("table").dataTable({
                processing: true,
                serverSide: true,
                ajax:{
                // type:"GET",
                type:"POST",
                url:"/Products/IndexJson",
                // dataSrc:function(data){
                    // 對收到的 data 要不要做加工，不要就直接 return
                    // alert(JSON.stringify(data)); 不知道要不要加工，先看一下。JSON轉字串
                    // 沒錯後可以註解掉
                    // return data;
                    // }
                },
                columns:[
                    // {data:"欄位",width:"寬度"}
                    // 要按照剛的Json 格式寫

                    // 共十欄，就一個10%均分
                     {data:"productId",width:"10%"},
                     {data:"productName",width:"10%"},
                     {data:"supplierId",width:"10%"},
                     {data:"categoryId",width:"10%"},
                     {data:"quantityPerUnit",width:"10%"},
                     {data:"unitPrice",width:"10%"},
                     {data:"unitsInStock",width:"10%"},
                     {data:"unitsOnOrder",width:"10%"},
                     {data:"reorderLevel",width:"10%"},
                     {data:"discontinued",width:"10%"},
                ],
                fixedHeader:{
                    headers:true
                },
                language:{
                     url: '//cdn.datatables.net/plug-ins/2.3.3/i18n/zh-HANT.json',
                },
            });
        });
    </script>
}