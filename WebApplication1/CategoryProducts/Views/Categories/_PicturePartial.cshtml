@model Category
@inject NorthwindContext context

@{
	Category? category =await context.Categories.FindAsync(Model.CategoryId);
	if(category !=null && category.Picture != null)
	{
		<img src="@Url.Action("GetPicture", "Categories", new { id = Model.CategoryId })" title="@Html.DisplayFor(model => model.CategoryName)" style="width:400px"/>
	}
	else
	{
		<img src="~/images/NoImage.jpeg" title="尚無圖片" asp-append-version="true"/>
	}
}

