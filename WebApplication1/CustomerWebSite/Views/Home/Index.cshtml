@{
    ViewData["Title"] = "Home Page";
}



<div class="text-center">
    <h1 class="display-4">Welcome:@TempData["Message"]</h1>
	<img src="~/images/cat.png" asp-append-version="true"/>
    <div class="container">
        <h3 class="mb-3 text-center">請選擇</h3>
        <div class="form-floating mb-3">
            <select class="form-select" asp-items="@ViewBag.CustomerCountry"></select>
            <label class="form-label">國家</label>
        </div>
    </div>


    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

@section Scripts
{
    <script>
       @Html.Raw(@ViewBag.Script) 
       //Html.Raw原始輸出不編碼，因此可執行javaScript
    </script>
}
